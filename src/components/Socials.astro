---
interface Props {
  variant?: 'inline' | 'pills';
}

const { variant = 'inline' } = Astro.props;

const links = [
  {
    name: 'linkedin',
    href: 'https://www.linkedin.com/in/chandana-v-04b1b124a/',
    label: 'LinkedIn',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    name: 'instagram',
    href: 'https://www.instagram.com/search_chandana',
    label: 'Instagram',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>`,
  },
  {
    name: 'email',
    href: 'mailto:chandanainfoinfo@gmail.com',
    label: 'Email',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>`,
  },
];
---

<ul class={`socials socials-${variant}`}>
  {
    links.map((l) => (
      <li>
        <a
          href={l.href}
          target={l.name === 'email' ? undefined : '_blank'}
          rel={l.name === 'email' ? undefined : 'me noopener'}
          aria-label={l.label}
        >
          <span class="social-icon" set:html={l.icon} />
          <span class="social-label">{l.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
  }

  .socials li {
    display: inline-flex;
    align-items: center;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .socials-inline a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }

  .socials-inline a:hover {
    color: var(--accent);
  }

  .socials-inline li + li::before {
    content: '·';
    margin: 0 0.7rem;
    color: var(--muted);
  }

  .socials-pills {
    gap: 8px;
  }

  .socials-pills a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    padding: 6px 14px;
    border-radius: 20px;
    border: 0.5px solid var(--border);
    color: var(--muted);
    background: var(--white);
    transition: all 0.2s;
  }

  .socials-pills a:hover {
    color: var(--accent-dark);
    background: var(--accent-light);
    border-color: var(--accent);
  }
</style>
