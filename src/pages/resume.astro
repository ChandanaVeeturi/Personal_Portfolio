---
import Layout from '../components/Layout.astro';
---

<Layout
  title="Resume — Chandana Veeturi"
  description="Resume — Business Analyst with expertise in data analysis, financial modelling, and business intelligence."
>
  <div class="page-header resume-header">
    <div>
      <h1>Resume</h1>
      <p>Data · Finance · Product</p>
    </div>
    <a class="btn-primary" href="/resume.pdf" style="white-space:nowrap;">
      Download PDF
    </a>
  </div>

  <div class="resume-layout">
    <aside class="resume-sidebar">
      <div class="section-label">Profile</div>
      <div class="sidebar-name">Chandana Veeturi</div>
      <div class="sidebar-role">
        Business Analyst · Data &amp; Finance
      </div>
      <div>
        <div class="contact-item">📍 Hyderabad, India</div>
        <div class="contact-item">
          ✉ <a href="mailto:chandanainfoinfo@gmail.com">chandanainfoinfo@gmail.com</a>
        </div>
        <div class="contact-item">
          🔗 <a href="https://www.linkedin.com/in/chandana-v-04b1b124a/" target="_blank" rel="noopener">linkedin/chandana-v</a>
        </div>
      </div>

      <div class="skills-group">
        <div class="section-label" style="margin-top:1.5rem;">Data &amp; BI Tools</div>
        <div class="skill-bar-wrap">
          <div class="skill-name"><span>Advanced Excel</span></div>
          <div class="skill-bar"><div class="skill-fill" style="width:95%"></div></div>
        </div>
        <div class="skill-bar-wrap">
          <div class="skill-name"><span>Power BI</span></div>
          <div class="skill-bar"><div class="skill-fill" style="width:90%"></div></div>
        </div>
        <div class="skill-bar-wrap">
          <div class="skill-name"><span>SQL</span></div>
          <div class="skill-bar"><div class="skill-fill" style="width:88%"></div></div>
        </div>
        <div class="skill-bar-wrap">
          <div class="skill-name"><span>Alteryx</span></div>
          <div class="skill-bar"><div class="skill-fill" style="width:85%"></div></div>
        </div>
        <div class="skill-bar-wrap">
          <div class="skill-name"><span>Python / Tableau</span></div>
          <div class="skill-bar"><div class="skill-fill" style="width:78%"></div></div>
        </div>
      </div>

      <div style="margin-top:1.5rem;">
        <div class="section-label">Education</div>
        <div style="font-size:14px;font-weight:500;">PGDM</div>
        <div style="font-size:12px;color:var(--muted);margin-top:3px;">
          IMT Hyderabad · 2024 · 8.31 (Top 10%)
        </div>
        <div style="font-size:14px;font-weight:500;margin-top:0.75rem;">B.Tech</div>
        <div style="font-size:12px;color:var(--muted);margin-top:3px;">
          Andhra University, Vizag · 2018 · 8.63 (Top 3%)
        </div>
      </div>

      <div style="margin-top:1.5rem;">
        <div class="section-label">Certifications</div>
        <div style="font-size:12px;color:var(--muted);line-height:1.9;">
          Certified Scrum Master · Scrum Alliance<br/>
          Google Project Management · Coursera<br/>
          Lean Six Sigma Green Belt · KPMG<br/>
          Microsoft Power BI · Udemy<br/>
          Tableau A-Z · Udemy<br/>
          Capital Markets · Udemy<br/>
          Financial Analysis · Udemy<br/>
          Complete SQL Bootcamp · Udemy
        </div>
      </div>
    </aside>

    <main class="resume-main">
      <div class="section-label">Experience</div>

      <div class="exp-item">
        <div class="exp-header">
          <div class="exp-title">Associate</div>
          <div class="exp-period">Dec 2025 – Present</div>
        </div>
        <div class="exp-company">Oxane Partners · Hyderabad</div>
        <ul class="exp-bullets">
          <li>Led high-impact initiatives across Direct Lending, Asset-Backed Lending, and Subline products with a strong focus on platform-based portfolio analytics and risk metrics.</li>
          <li>Automated servicer reports and borrowing base calculations by designing scalable data models, significantly improving reporting efficiency.</li>
          <li>Performed data lineage analysis and root-cause investigation across raw and reporting layers, identifying data quality issues and validating business rules.</li>
          <li>Handled diverse data constructs of different investment banking clients and delivered end-to-end client support through real-time portfolio monitoring and ad-hoc analytics.</li>
        </ul>
      </div>

      <div class="exp-item">
        <div class="exp-header">
          <div class="exp-title">Senior Analyst</div>
          <div class="exp-period">Apr 2024 – Dec 2025</div>
        </div>
        <div class="exp-company">Oxane Partners · Hyderabad</div>
        <ul class="exp-bullets">
          <li>Developed and maintained stratified dashboards using Power BI for 100+ client deals on the Panorama platform, enhancing data accessibility and decision-making.</li>
          <li>Built and automated end-to-end data pipelines using Alteryx, SQL, and Excel, ensuring 100% data accuracy and reducing processing time.</li>
          <li>Analyzed and transformed large-scale financial datasets, curating ETL layers to ensure data quality and generate actionable business insights for portfolio reporting and risk assessment.</li>
          <li>Collaborated with cross-functional teams to gather business requirements and translate Excel-based models into platform-ready data workflows.</li>
        </ul>
      </div>

      <div class="exp-item">
        <div class="exp-header">
          <div class="exp-title">Business Analyst — Intern</div>
          <div class="exp-period">2023</div>
        </div>
        <div class="exp-company">Tvisha Technologies · Hyderabad</div>
        <ul class="exp-bullets">
          <li>Interacted with clients, documented requirements, and drafted BRDs and FRDs for banking and e-commerce application development projects.</li>
          <li>Won the Best Summer Internship Performance Award (2024).</li>
        </ul>
      </div>

      <div class="exp-item">
        <div class="exp-header">
          <div class="exp-title">Business Analyst</div>
          <div class="exp-period">May 2018 – Jun 2022</div>
        </div>
        <div class="exp-company">Chegg India Pvt Ltd · Hyderabad</div>
        <ul class="exp-bullets">
          <li>Collaborated with Product Managers, Engineering, and QA teams to gather, analyze, and document requirements for 100+ internal product and process improvement initiatives.</li>
          <li>Authored and maintained BRDs, PRDs, user stories, acceptance criteria, process flows, and use cases.</li>
          <li>Partnered with cross-functional teams in Agile environments to support sprint planning, backlog refinement, UAT, and release activities.</li>
          <li>Designed process maps, workflow diagrams, and low-fidelity wireframes to visualize business processes and improve stakeholder alignment.</li>
          <li>Performed data analysis using SQL and Excel to identify process bottlenecks and provide actionable insights for decision-making.</li>
        </ul>
      </div>

      <div class="section-label" style="margin-top:2rem;">Achievements</div>
      <ul class="exp-bullets">
        <li>Value Champion Award Q3 2024–2025 at Oxane Partners</li>
        <li>Best Summer Internship Performance Award (2024)</li>
        <li>Star Performer, Q1 &amp; H1 2021 at Chegg India</li>
        <li>Public Speaker, Waltair Toastmasters Club (2019–2022)</li>
        <li>Point of Contact (POC), IMT Hyderabad &amp; Insightix Analytics Club</li>
      </ul>
    </main>
  </div>
</Layout>
